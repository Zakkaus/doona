8b534d93a533bbe27b56c3f1a3ded2c4a20219b0689c491ee9b45a8d57d6a4a9dc33d919238fd64550c2c19e599c432afc0ac7d23bdb4f3a9c2b1e6c5c4572f9  doona-precompressed-0.1.0-beta.18.tar.gz
