# Maintainer: Zakkaus <zakk@gentoozh.org>
pkgname=doona
pkgver=0.1.0_beta4
_tag=v0.1.0-beta.4
_upstream_ver=${_tag#v}
pkgrel=0
pkgdesc="Web UI for the daeuniverse engines"
url="https://github.com/Zakkaus/doona"
arch="noarch"
license="GPL-3.0-only AND 0BSD AND Apache-2.0 AND BSD-3-Clause AND ISC AND MIT"
subpackages="$pkgname-doc $pkgname-fonts:fonts:noarch"
source="$pkgname-$_upstream_ver.tar.gz::$url/releases/download/$_tag/$pkgname-$_upstream_ver.tar.gz
	$pkgname-fonts-$_upstream_ver.tar.gz::$url/releases/download/$_tag/$pkgname-fonts-$_upstream_ver.tar.gz
	"
options="!check" # static files
builddir="$srcdir"

# Both archives hold their files at the root: unpack each into its own directory.
unpack() {
	mkdir -p "$srcdir"/web "$srcdir"/fonts
	tar -xzf "$srcdir"/$pkgname-$_upstream_ver.tar.gz -C "$srcdir"/web
	tar -xzf "$srcdir"/$pkgname-fonts-$_upstream_ver.tar.gz -C "$srcdir"/fonts
}

package() {
	mkdir -p "$pkgdir"/usr/share/doona
	cp -a "$srcdir"/web/. "$pkgdir"/usr/share/doona/
	rm -rf "$pkgdir"/usr/share/doona/LICENSE "$pkgdir"/usr/share/doona/LICENSES "$pkgdir"/usr/share/doona/NOTICE "$pkgdir"/usr/share/doona/*.md
	install -Dm644 "$srcdir"/web/NOTICE -t "$pkgdir"/usr/share/doc/$pkgname/
	install -Dm644 "$srcdir"/web/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
	install -Dm644 "$srcdir"/web/LICENSES/Apache-2.0.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}

fonts() {
	pkgdesc="Noto Sans TC/SC for doona"
	license="OFL-1.1"
	depends="$pkgname=$pkgver-r$pkgrel"
	mkdir -p "$subpkgdir"/usr/share/doona
	cp -a "$srcdir"/fonts/fonts "$subpkgdir"/usr/share/doona/
}

# Placeholder SHA-512 values: replace both with `abuild checksum` after publication.
sha512sums="
0  doona-0.1.0-beta.4.tar.gz
0  doona-fonts-0.1.0-beta.4.tar.gz
"
